{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "ignoreDeprecations": "5.0",
    "skipLibCheck": true
  },
  "include": ["src", "generated/prisma"],
  "exclude": [
    "node_modules",
    "dist",
    ".agents",
    ".claude",
    ".vscode",
    "prisma/migrations",
    "prisma/later.txt"
  ]
}
